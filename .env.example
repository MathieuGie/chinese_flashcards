# Optional: enables high-quality AI enrichment (best sense, emoji, 6 tailored
# example sentences) when adding words. Without it: CC-CEDICT + Tatoeba.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: protect the site with a password (recommended once deployed).
APP_PASSWORD=

# Required on Vercel (the filesystem there is not persistent). Create a free
# database at https://turso.tech and paste its URL + token. Locally, leave
# empty to use the ./local.db SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
